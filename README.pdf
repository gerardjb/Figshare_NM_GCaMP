T*
(  figure4/correlation_tbl_jG8f.mat.) Tj
T*
(- supp_figure10: example high/low SNR spike predictions and discrete spike timing metrics.) Tj
T*
(- supp_figure11: STA/SNA bias and uncertainty distributions for matched or unmatched jGCaMP8f) Tj
T*
(  detections. Run with run_supp_figure11_A_code.) Tj
T*
(- supp_figure12: trialwise jGCaMP8f analyses using packaged CSV/NPZ exports. Run with) Tj
T*
